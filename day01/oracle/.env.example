# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=poolside/laguna-s-2.1:free
LLM_BASE_URL=https://openrouter.ai/api/v1
# Reasoning effort for thinking models: off | low | medium | high. Lower is faster.
LLM_REASONING=low
# Total attempts per model call before giving up (free tiers fail transiently)
LLM_MAX_ATTEMPTS=3
# Where the agent's tools find the prediction API. Same process on Day 1.
MODEL_API_URL=http://localhost:8000
# Where joblib artifacts are loaded from (default: ./artifacts)
# ARTIFACTS_DIR=./artifacts
